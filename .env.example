# MongoDB
MONGO_URI=mongodb://localhost:27017/
MONGO_DATABASE=hydroalert_ai
MONGO_COLLECTION=telemetria
MONGO_TIMEOUT_MS=2000

# MQTT (Eclipse Mosquitto)
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_KEEPALIVE=60
MQTT_QOS=1
MQTT_TOPIC_PREFIX=hydroalert/telemetria
# Autenticacao opcional do broker (deixe comentado no prototipo local):
# MQTT_USERNAME=
# MQTT_PASSWORD=
# Ativa TLS na conexao MQTT (true/false):
# MQTT_TLS=false

# API FastAPI
# Se definido, todos os endpoints /api/* exigem o header X-API-Key:
# API_TOKEN=
# Origens permitidas no CORS, separadas por virgula (padrao: *):
# API_CORS_ORIGINS=*

# Alertas automaticos
# Quantidade de leituras consecutivas acima da cota de alerta para disparar:
ALERTA_LEITURAS_CONSECUTIVAS=3

# Simulacao e dados
# INTERVALO_PADRAO_SEGUNDOS=5
# HYDROALERT_DATA_DIR=
# LOG_LEVEL=INFO

# Open-Meteo (chuva real)
# OPEN_METEO_TIMEOUT_S=5

# MongoDB
MONGO_URI=mongodb://localhost:27017/
MONGO_DATABASE=hydroalert_ai
MONGO_COLLECTION=telemetria
MONGO_TIMEOUT_MS=2000
# Expira documentos automaticamente apos N dias (0 = desativado)
# MONGO_TTL_DIAS=30

# MQTT (Eclipse Mosquitto)
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_QOS=1
MQTT_TOPIC_PREFIX=hydroalert/telemetria
# Autenticacao opcional do broker (deixe comentado no prototipo local)
# MQTT_USERNAME=usuario
# MQTT_PASSWORD=senha

# API FastAPI
# Token opcional: quando definido, os endpoints /api/* exigem o header X-API-Key
# API_TOKEN=troque-por-um-token-forte
# Origens permitidas no CORS, separadas por virgula (padrao: *)
# CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Open-Meteo (clima real)
# OPEN_METEO_TIMEOUT_S=5
# OPEN_METEO_CACHE_TTL_S=300

# Logs (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# Simulacao
# INTERVALO_PADRAO_SEGUNDOS=5
